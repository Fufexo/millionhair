---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/michroma/400.css';
import '@/styles/global.scss';
import { site } from '@/data/site';
import { barberShopSchema } from '@/lib/schema';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · Barbería en Miraflores, Lima`,
  description = site.description,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL('/og.jpg', siteUrl).toString();
const schema = barberShopSchema(siteUrl, ogImage);
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Póster del hero (LCP): el mismo criterio que Hero.astro usa para elegir el video -->
    <link
      rel="preload"
      href="/video/hero-poster.jpg"
      as="image"
      fetchpriority="high"
      media="not all and (min-width: 48rem) and (orientation: landscape)"
    />
    <link
      rel="preload"
      href="/video/hero-wide-poster.jpg"
      as="image"
      fetchpriority="high"
      media="(min-width: 48rem) and (orientation: landscape)"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
