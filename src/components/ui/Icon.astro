---
/** Íconos de trazo propios (sin dependencias). Decorativos por defecto. */
const icons = {
  menu: '<path d="M4 8h16M4 16h16"/>',
  'chevron-left': '<path d="M15 6l-6 6 6 6"/>',
  'chevron-right': '<path d="M9 6l6 6-6 6"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  'arrow-up-right': '<path d="M7 17L17 7M9 7h8v8"/>',
  star: '<path d="M12 2.8l2.8 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17.5l-6.1 3.6 1.6-6.8-5.2-4.6 6.9-.6z" fill="currentColor" stroke="none"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0113 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  parking: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M10 16.5v-9h3a3 3 0 010 6h-3"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={icons[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
