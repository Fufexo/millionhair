---
import { Image } from 'astro:assets';
import { team } from '@/data/team';
import { site } from '@/data/site';
import teamPhoto from '@/assets/team/equipo.jpg';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';

// Cada barbero más una tarjeta final para "el equipo": todas comparten el mismo markup
const cards = [
  ...team.map((b) => ({
    name: b.name,
    badge: b.role,
    photo: b.photo,
    alt: `${b.name}, ${b.role?.toLowerCase() ?? 'barbero'} de ${site.name}`,
    focus: b.focus,
    video: b.video,
    instagram: b.instagram,
    bookingUrl: b.bookingUrl,
    bookingLabel: `Reservar con ${b.name}`,
  })),
  {
    name: 'El equipo',
    badge: undefined,
    photo: teamPhoto,
    alt: `Logo de ${site.name} en una silla de barbero cromada`,
    focus: undefined,
    video: '/video/team',
    instagram: site.instagram,
    bookingUrl: site.bookingUrl,
    bookingLabel: 'Reservar cita',
  },
];
---

<section id="equipo" class="team theme-light" aria-labelledby="equipo-title">
  <div class="container">
    <div class="head">
      <SectionHeader kicker="Equipo" title="Elige a tu barbero" id="equipo-title" />
      <p class="lede">Reserva directo con quien te corta. Sus trabajos están en su Instagram.</p>
    </div>

    <!-- Cuatro tarjetas con la misma estructura: foto, nombre, Instagram y reserva.
         Kaleb se distingue con la etiqueta de fundador.
         Cada tarjeta (también la del equipo) tiene un clip: aparece sobre la foto al pasar el mouse
         (en táctil, cuando la tarjeta está en pantalla). -->
    <ul class="cards" role="list">
      {cards.map((c) => (
        <li class="card">
          <div class="photo">
            <Image
              src={c.photo}
              alt={c.alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 22vw, 50vw"
              loading="lazy"
              style={c.focus && `object-position: ${c.focus}`}
            />
            {c.video && (
              <video class="clip" data-hover-video muted loop playsinline preload="none" aria-hidden="true">
                <source src={`${c.video}.webm`} type="video/webm" />
                <source src={`${c.video}.mp4`} type="video/mp4" />
              </video>
            )}
            {c.badge && <span class="badge">{c.badge}</span>}
          </div>
          <div class="info">
            <h3 class="name">{c.name}</h3>
            <a class="ig" href={c.instagram.url}>{c.instagram.handle}</a>
            <Button href={c.bookingUrl} variant="link">{c.bookingLabel}</Button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style lang="scss">
  @use '@/styles/mixins' as *;

  .team {
    padding-block: var(--section-pad);
  }

  /* Título a la izquierda, bajada a la derecha, alineados por la base */
  .head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-7);

    @include up('md') {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: var(--s-8);
      align-items: end;
      margin-bottom: var(--s-8);
    }
  }

  .lede {
    max-width: 34ch;
    color: var(--muted);
  }

  /* Móvil y tablet: 2 × 2. Escritorio: 4 columnas. Todas del mismo tamaño. */
  .cards {
    @include reset-list;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-3);
    align-items: start;

    @include up('md') {
      gap: var(--s-7) var(--s-5);
    }

    @include up('lg') {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }

  .photo {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--c-concrete);

    :global(img),
    :global(video) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      @include mono(1);
      transition: filter 0.5s var(--ease-out);
    }
  }

  /* Al pasar el mouse la foto pasa a color */
  @media (hover: hover) {
    .card:hover .photo :global(img),
    .card:hover .photo :global(video) {
      filter: grayscale(0);
    }
  }

  /* Clip del barbero: oculto sobre la foto hasta que se activa */
  .photo .clip {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition:
      opacity 0.45s var(--ease-out),
      filter 0.5s var(--ease-out);
  }

  .card.is-playing .clip {
    opacity: 1;
  }

  .badge {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    padding: 0.3rem 0.5rem;
    background: var(--c-ink);
    color: var(--c-white);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    @include up('md') {
      top: var(--s-4);
      left: var(--s-4);
      font-size: 0.6875rem;
    }
  }

  .info {
    display: grid;
    justify-items: start;
    gap: var(--s-1);
    padding-top: var(--s-4);
  }

  .name {
    font-size: 1.25rem;
    font-weight: 700;
    font-stretch: 125%;
    text-transform: uppercase;
  }

  .ig {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    font-size: 0.875rem;
    color: var(--muted);
    @include underline-on-hover;
  }
</style>

<script>
  import { onReducedMotion, playMuted } from '@/lib/motion';

  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const clips = document.querySelectorAll<HTMLVideoElement>('video[data-hover-video]');

  // El clip solo se muestra sobre la foto cuando de verdad empezó a reproducirse
  const start = async (video: HTMLVideoElement) => {
    if (await playMuted(video)) video.closest('.card')?.classList.add('is-playing');
  };

  const stop = (video: HTMLVideoElement, rewind = true) => {
    video.closest('.card')?.classList.remove('is-playing');
    video.pause();
    if (rewind) video.currentTime = 0;
  };

  if (canHover.matches) {
    // Escritorio: el clip corre mientras el mouse (o el foco) está en la tarjeta
    clips.forEach((video) => {
      const card = video.closest<HTMLElement>('.card');
      if (!card) return;
      card.addEventListener('mouseenter', () => start(video));
      card.addEventListener('mouseleave', () => stop(video));
      card.addEventListener('focusin', () => start(video));
      card.addEventListener('focusout', (e) => {
        if (!card.contains(e.relatedTarget as Node)) stop(video);
      });
    });
  } else {
    // Táctil: se reproduce cuando la tarjeta está casi entera en pantalla
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) start(video);
          else stop(video, false);
        }
      },
      { threshold: 0.6 },
    );
    clips.forEach((v) => io.observe(v));
  }

  onReducedMotion(() => clips.forEach((v) => stop(v)));
</script>
