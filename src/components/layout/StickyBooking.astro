---
import { site } from '@/data/site';
import Button from '@/components/ui/Button.astro';
import OpenStatus from '@/components/ui/OpenStatus.astro';
---

<aside class="sticky-booking theme-dark" aria-label="Reservar cita">
  <div class="info">
    <p class="status"><OpenStatus /></p>
    <p class="sub">Confirmación al instante</p>
  </div>
  <Button href={site.bookingUrl} variant="inverse" data-book>Reservar</Button>
</aside>

<style lang="scss">
  @use '@/styles/mixins' as *;

  .sticky-booking {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4) calc(var(--s-3) + env(safe-area-inset-bottom));
    background: ink(0.94);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--rule);
    transition: transform 0.3s var(--ease-out);

    @include up('md') {
      display: none;
    }
  }

  /* El menú móvil abierto la tapa: se esconde hacia abajo */
  :global(body[data-menu-open='true']) .sticky-booking {
    transform: translateY(110%);
  }

  .info {
    flex: 1;
    min-width: 0;
  }

  .status {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sub {
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
